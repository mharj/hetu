{
    "name": "fi-pin",
    "version": "0.0.11",
    "description": "Finnish Personal Identification Number validate + gender check",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        "import": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
        },
        "default": "./dist/index.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@types/node": "^25.9.5",
        "@vitest/coverage-v8": "^5.0.1",
        "c8": "^12.0.0",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2",
        "vite": "^8.1.4",
        "vitest": "^5.0.1",
        "zod": "^4.4.3"
    },
    "scripts": {
        "build": "tsdown src/index.ts --sourcemap --format cjs,esm --dts --clean",
        "prepublishOnly": "npm run build",
        "test": "vitest test --typecheck --run --no-isolate --coverage",
        "lint": "biome check",
        "validate": "tsc --noEmit"
    },
    "keywords": ["pin", "personid", "finnish"],
    "files": ["dist"],
    "repository": "github:mharj/hetu",
    "author": "mharj",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/mharj/hetu/issues"
    },
    "homepage": "https://github.com/mharj/hetu#readme",
    "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
